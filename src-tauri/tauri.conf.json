{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Double Interlock",
  "version": "1.0.0",
  "identifier": "com.abeborg.doubleinterlock",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Double Interlock",
      "width": 1600,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true,
      "backgroundColor": "#070b0f"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "license": "LicenseRef-Proprietary",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 Abraham Borg. All rights reserved.",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "A fire protection sim for hyperscale data centers",
    "category": "SimulationGame",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "Double Interlock",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
